# Database Config
DATABASE_URL=postgresql://docuai_user:docuai_password@postgres:5432/docuai_db

# Redis Config
REDIS_URL=redis://redis:6379/0

# Storage Config (MinIO for local, S3 for Prod)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docuai-bucket
S3_ACCESS_KEY=docuai_minio_user
S3_SECRET_KEY=docuai_minio_password

# Authentication
SECRET_KEY=your-super-secret-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider
# If using Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# If using OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key

# Integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Provider
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Observability
SENTRY_DSN=
POSTHOG_KEY=

# OCR Config
OCR_PROVIDER=paddleocr
